   <div id="settings-backdrop" class="settings-backdrop" hidden=""></div>
   <aside id="settings-panel" class="settings-panel" aria-labelledby="settings-title" aria-modal="true" role="dialog" hidden="">
    <div class="settings-head">
     <div>
      <h2 id="settings-title" data-template-id="settings-title" class="canva-text" style="color: rgb(240, 250, 248); font-weight: 700; font-style: normal; font-size: 24px;">Configurar destinos</h2>
      <p data-template-id="settings-description" class="canva-text settings-copy" style="color: rgb(191, 212, 209); font-weight: 400; font-style: normal; font-size: 12px;">Reemplaza los nombres y las URLs provisionales. Los cambios de este panel duran durante esta visita; también puedes editar los nombres desde Canva.</p>
     </div><button id="settings-dismiss" type="button" class="tool-button" aria-label="Cerrar configuración">✕</button>
    </div>
    <form id="settings-form" class="settings-form">
     <div id="settings-fields"></div>
     <div class="form-actions">
      <button type="submit" data-template-id="settings-save" class="canva-button save-button" style="background: rgb(186, 244, 232); color: rgb(9, 41, 44); font-weight: 800; font-style: normal; font-size: 16px;">Aplicar cambios</button> <span id="form-message" class="form-message" role="status" aria-live="polite"></span>
     </div>
    </form>
   </aside>
  </div>
  <script>
    (() => {
      const cards = [...document.querySelectorAll('.module')];
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const mobile = window.matchMedia('(max-width: 800px)');
      const names = Array.from({length:12}, (_,i) => `Sistema ${String(i+1).padStart(2,'0')}`);
      const urls = Array.from({length:12}, (_,i) => `https://example.com/sistema-${String(i+1).padStart(2,'0')}`);
      const overridden = Array(12).fill(false);
      const toggle = document.getElementById('orbit-toggle');
      const panel = document.getElementById('settings-panel');
      const backdrop = document.getElementById('settings-backdrop');
      const settingsToggle = document.getElementById('settings-toggle');
      const form = document.getElementById('settings-form');
      const fields = document.getElementById('settings-fields');
      const message = document.getElementById('form-message');
      let paused = reducedMotion.matches;
      let hovered = false;
      let angle = 0;
      let lastTime = 0;
      let previousFocus = null;
      const localDate = document.getElementById('local-date');
      const localTime = document.getElementById('local-time');
      const localWeather = document.getElementById('local-weather');
      const weatherRefresh = document.getElementById('weather-refresh');
      const dateFormatter = new Intl.DateTimeFormat(undefined, {weekday:'short', day:'2-digit', month:'short', year:'numeric'});
      const timeFormatter = new Intl.DateTimeFormat(undefined, {hour:'2-digit', minute:'2-digit', second:'2-digit'});
      const sky = document.getElementById('constellation-layer'); const localLocation = document.getElementById('local-location'); const localCoordinates = document.getElementById('local-coordinates'); const locationRefresh = document.getElementById('location-refresh'); const coordinatesToggle = document.getElementById('coordinates-toggle'); let lastCoords = null;
      function updateSky() { const now = new Date(); const hour = now.getHours() + now.getMinutes()/60; sky.classList.toggle('is-night', hour < 6 || hour >= 19); sky.style.transform = `rotate(${((now.getTime()/86400000)%1)*2-1}deg)`; }
      function updateClock() { const now = new Date(); localDate.textContent = dateFormatter.format(now); localTime.textContent = timeFormatter.format(now); updateSky(); }
      function requestLocation() { localLocation.textContent='Solicitando ubicación…'; navigator.geolocation?.getCurrentPosition(({coords}) => { lastCoords=coords; localLocation.textContent='Ubicación autorizada'; localCoordinates.textContent=`${coords.latitude.toFixed(2)}°, ${coords.longitude.toFixed(2)}°`; sky.classList.add('is-night'); loadWeather(coords); }, error => { localLocation.textContent=error.code===1?'Permiso de ubicación rechazado':'Ubicación no disponible'; localCoordinates.textContent='Precisión limitada'; sky.classList.add('is-limited'); loadWeather(); }, {enableHighAccuracy:false,maximumAge:300000,timeout:10000}); }
      if (coordinatesToggle) coordinatesToggle.addEventListener('click', () => { const hidden = localCoordinates.hidden = !localCoordinates.hidden; coordinatesToggle.setAttribute('aria-pressed', String(!hidden)); coordinatesToggle.setAttribute('aria-label', hidden ? 'Mostrar coordenadas' : 'Ocultar coordenadas'); }); if (locationRefresh) locationRefresh.addEventListener('click', requestLocation);
      async function fetchWeather(coords) { try { const response=await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${coords.latitude}&longitude=${coords.longitude}&current=temperature_2m&temperature_unit=celsius`); if(!response.ok) throw new Error('weather'); const data=await response.json(); const value=data?.current?.temperature_2m; localWeather.textContent=typeof value==='number'?`${Math.round(value)} °C`:'Temperatura no disponible'; } catch { localWeather.textContent='Temperatura no disponible'; } }
      async function loadWeather(position) {
        localWeather.textContent = 'Solicitando…';
        if (position) { await fetchWeather(position); return; }
        if (!navigator.geolocation) { localWeather.textContent = 'Temperatura no disponible'; return; }
        navigator.geolocation.getCurrentPosition(async ({coords}) => {
          try { const response = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${coords.latitude}&longitude=${coords.longitude}&current=temperature_2m&temperature_unit=celsius`); if (!response.ok) throw new Error('weather'); const data = await response.json(); const value = data?.current?.temperature_2m; localWeather.textContent = typeof value === 'number' ? `${Math.round(value)} °C` : 'Temperatura no disponible'; }
          catch { localWeather.textContent = 'Temperatura no disponible'; }
        }, () => { localWeather.textContent = 'Temperatura no disponible'; }, {maximumAge:300000, timeout:10000});
      }
      updateClock(); setInterval(updateClock, 1000); weatherRefresh.addEventListener('click', () => loadWeather(lastCoords)); requestLocation();
      if (window.lucide) lucide.createIcons();

      function setPaused(value) {
        paused = value;
        toggle.setAttribute('aria-pressed', String(value));
        toggle.querySelector('[data-template-id="pause-label"]').hidden = value;
        toggle.querySelector('[data-template-id="resume-label"]').hidden = !value;
      }
      setPaused(paused);
      toggle.addEventListener('click', () => setPaused(!paused));
      reducedMotion.addEventListener('change', event => setPaused(event.matches));

      function positionCards() {
        if (mobile.matches) {
          cards.forEach(card => { card.style.transform = ''; card.style.zIndex = ''; card.style.opacity = ''; });
          return;
        }
        const width = document.querySelector('.scene').clientWidth;
        const rx = Math.min(width * .375, 480);
        const ry = Math.min(width * .145, 178);
        cards.forEach((card,i) => {
          const a = angle + (i / 12) * Math.PI * 2;
          const depth = Math.sin(a);
          const scale = .79 + (depth + 1) * .16;
          const x = Math.cos(a) * rx;
          const y = Math.sin(a) * ry - Math.cos(a) * 24;
          const active = card.matches(':hover,:focus-visible');
          card.style.transform = `translate(calc(-50% + ${x}px), calc(-50% + ${y}px)) scale(${active ? scale * 1.16 : scale}) translateY(${active ? '-12px' : '0px'})`;
          card.style.zIndex = active ? '30' : String(10 + Math.round(depth * 5));
          card.style.opacity = String(.7 + (depth + 1) * .15);
        });
      }
      cards.forEach((card,i) => {
        card.addEventListener('mouseenter', () => { hovered = true; positionCards(); });
        card.addEventListener('mouseleave', () => { hovered = false; positionCards(); });
        card.addEventListener('focus', () => { hovered = true; positionCards(); });
        card.addEventListener('blur', () => { hovered = cards.some(item => item.matches(':hover,:focus')); positionCards(); });
        card.addEventListener('click', () => window.open(urls[i], '_blank', 'noopener,noreferrer'));
        card.addEventListener('keydown', event => {
          if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
          event.preventDefault();
          const next = cards[(i + (event.key === 'ArrowRight' ? 1 : 11)) % 12];
          next.focus();
          if (mobile.matches) next.scrollIntoView({behavior:reducedMotion.matches?'instant':'smooth',block:'nearest',inline:'center'});
        });
      });
      mobile.addEventListener('change', positionCards);
      window.addEventListener('resize', positionCards);

      function animate(time) {
        const delta = Math.min((time - (lastTime || time)) / 1000, .06);
        lastTime = time;
        if (!paused && !hovered && !mobile.matches && !reducedMotion.matches) angle += delta * .075;
        positionCards();
        if (planet && !paused && !reducedMotion.matches) planet.rotation.y += delta * .055;
        if (renderer && scene3d && camera) renderer.render(scene3d,camera);
        requestAnimationFrame(animate);
      }

      function closeSettings() {
        panel.hidden = true;
        backdrop.hidden = true;
        settingsToggle.setAttribute('aria-expanded','false');
        settingsToggle.querySelector('[data-template-id="settings-open-label"]').hidden = false;
        settingsToggle.querySelector('[data-template-id="settings-close-label"]').hidden = true;
        previousFocus?.focus();
      }
      function openSettings() {
        previousFocus = document.activeElement;
        panel.hidden = false;
        backdrop.hidden = false;
        settingsToggle.setAttribute('aria-expanded','true');
        settingsToggle.querySelector('[data-template-id="settings-open-label"]').hidden = true;
        settingsToggle.querySelector('[data-template-id="settings-close-label"]').hidden = false;
        message.textContent = '';
        fields.querySelector('input')?.focus();
      }
      settingsToggle.addEventListener('click', () => panel.hidden ? openSettings() : closeSettings());
      document.getElementById('settings-dismiss').addEventListener('click',closeSettings);
      backdrop.addEventListener('click',closeSettings);
      panel.addEventListener('keydown', event => {
        if (event.key === 'Escape') { closeSettings(); return; }
        if (event.key !== 'Tab') return;
        const focusables = [...panel.querySelectorAll('button,input')];
        const first = focusables[0], last = focusables[focusables.length-1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
      });

      // The settings form changes session-only overrides; Canva-editable names remain in the DOM.
      names.forEach((name,i) => {
        const row = document.createElement('div');
        row.className = 'settings-row';
        const heading = document.createElement('h3');
        heading.textContent = `SISTEMA ${String(i+1).padStart(2,'0')}`;
        const nameLabel = document.createElement('label');
        nameLabel.htmlFor = `edit-name-${i}`;
        nameLabel.textContent = 'Nombre';
        const nameInput = document.createElement('input');
        nameInput.id = nameLabel.htmlFor;
        nameInput.name = `name-${i}`;
        nameInput.value = name;
        nameInput.maxLength = 35;
        nameInput.required = true;
        const urlLabel = document.createElement('label');
        urlLabel.htmlFor = `edit-url-${i}`;
        urlLabel.textContent = 'URL (placeholder: reemplazar antes de publicar)';
        const urlInput = document.createElement('input');
        urlInput.id = urlLabel.htmlFor;
        urlInput.name = `url-${i}`;
        urlInput.type = 'url';
        urlInput.inputMode = 'url';
        urlInput.value = urls[i];
        urlInput.required = true;
        row.append(heading,nameLabel,nameInput,urlLabel,urlInput);
        fields.append(row);
      });
      form.addEventListener('submit', event => {
        event.preventDefault();
        const nextNames = [], nextUrls = [];
        for (let i=0;i<12;i++) {
          const name = form.elements[`name-${i}`].value.trim();
          const rawUrl = form.elements[`url-${i}`].value.trim();
          let parsed;
          try { parsed = new URL(rawUrl); } catch { message.textContent = `Revisa la URL del sistema ${i+1}.`; form.elements[`url-${i}`].focus(); return; }
          if (!name || parsed.protocol !== 'https:') {
            message.textContent = `El sistema ${i+1} necesita un nombre y una URL HTTPS.`;
            form.elements[!name ? `name-${i}` : `url-${i}`].focus();
            return;
          }
          nextNames.push(name); nextUrls.push(parsed.href);
        }
        nextNames.forEach((name,i) => {
          names[i] = name; urls[i] = nextUrls[i]; overridden[i] = true;
          cards[i].querySelector(`[data-template-id="system-${String(i+1).padStart(2,'0')}-name"]`).hidden = true;
          const runtimeName = cards[i].querySelector('.runtime-name');
          runtimeName.textContent = name;
          runtimeName.style.display = 'block';
          cards[i].setAttribute('aria-label',`Abrir ${name} en una pestaña nueva`);
        });
        message.textContent = 'Cambios aplicados durante esta visita.';
      });

      let renderer, scene3d, camera, planet;
      try {
        if (window.THREE) {
          const holder = document.getElementById('planet-canvas');
          scene3d = new THREE.Scene();
          camera = new THREE.PerspectiveCamera(36,1,.1,100);
          camera.position.set(0,0,8.8);
          renderer = new THREE.WebGLRenderer({alpha:true,antialias:true,powerPreference:'low-power'});
          renderer.setPixelRatio(Math.min(devicePixelRatio,1.7));
          holder.appendChild(renderer.domElement);
          const geometry = new THREE.SphereGeometry(2,64,48);
          const material = new THREE.ShaderMaterial({
            uniforms:{},
            vertexShader:`varying vec3 vNormal; varying vec3 vPos; void main(){vNormal=normalize(normalMatrix*normal);vPos=position;gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.);}`,
            fragmentShader:`varying vec3 vNormal; varying vec3 vPos;
              float hash(vec3 p){p=fract(p*.1031);p+=dot(p,p.yzx+33.33);return fract((p.x+p.y)*p.z);}
              float noise(vec3 p){vec3 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);return mix(mix(mix(hash(i),hash(i+vec3(1,0,0)),f.x),mix(hash(i+vec3(0,1,0)),hash(i+vec3(1,1,0)),f.x),f.y),mix(mix(hash(i+vec3(0,0,1)),hash(i+vec3(1,0,1)),f.x),mix(hash(i+vec3(0,1,1)),hash(i+vec3(1,1,1)),f.x),f.y),f.z);}
              void main(){vec3 n=normalize(vNormal);float land=noise(vPos*1.9)*.57+noise(vPos*4.8)*.3+noise(vPos*12.)*.13;float mask=smoothstep(.44,.57,land);vec3 ocean=mix(vec3(.013,.10,.16),vec3(.035,.32,.40),noise(vPos*3.));vec3 ground=mix(vec3(.10,.38,.35),vec3(.38,.68,.52),noise(vPos*8.));vec3 col=mix(ocean,ground,mask);float light=max(dot(n,normalize(vec3(-.55,.55,1.))),0.);col*=.17+light*.97;float rim=pow(1.-max(dot(n,vec3(0.,0.,1.)),0.),3.);col+=vec3(.13,.65,.73)*rim*.75;gl_FragColor=vec4(col,1.);}`
          });
          planet = new THREE.Mesh(geometry,material);
          scene3d.add(planet);
          const atmosphere = new THREE.Mesh(new THREE.SphereGeometry(2.08,48,32),new THREE.ShaderMaterial({
            transparent:true,depthWrite:false,side:THREE.BackSide,
            vertexShader:`varying vec3 vN;void main(){vN=normalize(normalMatrix*normal);gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.);}`,
            fragmentShader:`varying vec3 vN;void main(){float a=pow(1.-abs(vN.z),3.)*.32;gl_FragColor=vec4(.22,.83,.87,a);}`
          }));
          scene3d.add(atmosphere);
          function resizePlanet() {
            const w=holder.clientWidth,h=holder.clientHeight;
            renderer.setSize(w,h,false);
            camera.aspect=w/h;
            camera.position.z=mobile.matches ? 11.4 : 8.8;
            camera.lookAt(0,mobile.matches ? 1.1 : 0,0);
            camera.updateProjectionMatrix();
          }
          resizePlanet();
          window.addEventListener('resize',resizePlanet);
        }
      } catch {
        document.getElementById('planet-canvas').style.background='radial-gradient(circle at 48% 48%,#397f78 0%,#123c4b 21%,#061820 29%,transparent 30%)';
        renderer = null;
      }
      positionCards();
      requestAnimationFrame(animate);
    })();
  </script>
 
